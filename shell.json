{
  "bar": {
    "centerAnchor": "main.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "main.clock",
          "verticalFormat": "HH\n—\nmm",
          "worldClocks": [
            {
              "label": "Local",
              "timeZone": "local"
            },
            {
              "label": "UTC",
              "timeZone": "UTC"
            },
            {
              "label": "New York",
              "timeZone": "America/New_York"
            },
            {
              "label": "London",
              "timeZone": "Europe/London"
            },
            {
              "label": "Tokyo",
              "timeZone": "Asia/Tokyo"
            },
            {
              "label": "Sydney",
              "timeZone": "Australia/Sydney"
            }
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "main.weather"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "main.media"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "main.nightlight"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.nightlight"
  ],
  "cloneSourceRestores": [
    "main.media",
    "main.nightlight"
  ]
}
